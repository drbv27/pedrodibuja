# Public site URL. Every absolute URL derives from this value:
# metadataBase, canonicals, sitemap.xml, robots.txt, JSON-LD and og:image.
# No trailing slash. Must be set before the first production build.
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 measurement ID, format G-XXXXXXXXXX.
# Also enable Enhanced Measurement in the GA4 admin panel.
NEXT_PUBLIC_GA_ID=

# Resend API key used by the contact form server action.
RESEND_API_KEY=

# Inbox that receives contact form messages. While no custom domain is
# verified in Resend, this MUST be the exact address the Resend account
# was registered with, or delivery fails with a 403.
CONTACT_TO=
